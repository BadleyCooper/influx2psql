INFLUX_URL=http://localhost:8086
INFLUX_ORG=my-org
INFLUX_BUCKET=my-bucket
INFLUX_TOKEN=replace_me
INFLUX_MEASUREMENT=cpu

PG_DSN=postgresql://etl_user:etl_pass@localhost:5432/etl_db
PG_TARGET_TABLE=metrics_influx
PG_WATERMARK_TABLE=etl_watermarks
PG_JOB_NAME=influx_cpu_to_pg

DRY_RUN=false


INITIAL_START_TS=2026-01-01T00:00:00Z
OVERLAP_SECONDS=300
BATCH_SIZE=5000

HTTP_TIMEOUT_SECONDS=60
HTTP_RETRIES=5
HTTP_BACKOFF_FACTOR=0.5

LOG_LEVEL=INFO
STRUCTURED_LOGS=false
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=8000
